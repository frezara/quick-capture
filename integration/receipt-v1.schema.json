{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "capture_id": {
      "type": "string",
      "format": "uuid"
    },
    "organiser_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "operation_id",
    "capture_id",
    "organiser_item_id",
    "payload_sha256",
    "accepted_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
